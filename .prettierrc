{
	"arrowParens": "always",
	"jsxSingleQuote": true,
	"singleQuote": true,
	"useTabs": true,
	"tabWidth": 4,
	"trailingComma": "es5",
	"importOrder": [
		"<THIRD_PARTY_MODULES>",
		"@/app/(.*)$",
		"@/screens/(.*)$",
		"@/widgets/(.*)$",
		"@/features/(.*)$",
		"@/entities/(.*)$",
		"@/shared/(.*)$",
		"^../(.*)$",
		"^./(.*)$",
		"(.css)$"
	],
	"plugins": [
		"@trivago/prettier-plugin-sort-imports",
		"prettier-plugin-tailwindcss"
	]
}
